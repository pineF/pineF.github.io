---
interface Props {
  brandName?: string;
  githubUrl?: string;
}

const { brandName = "Portfolio", githubUrl = "https://github.com/pineF" } = Astro.props;

const navItems = [
  { label: "About", href: "#about" },
  { label: "Interests", href: "#research" },
  { label: "Publications", href: "#publications" },
  { label: "Tech Stack", href: "#tech" },
  { label: "History", href: "#timeline" },
];
---

<header class="navbar-wrapper">
  <nav class="navbar" aria-label="メインナビゲーション">
    <div class="nav-left">
      <a href="#" class="nav-brand" title="ページトップへ">
        <span class="brand-monogram">P</span>
        <span class="brand-name">{brandName}</span>
      </a>
    </div>

    <ul class="nav-links">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="nav-link">
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      {githubUrl && (
        <a
          href={githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-btn"
          aria-label="GitHubプロフィール"
          title="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      )}
      <button
        id="theme-toggle"
        class="icon-btn"
        aria-label="テーマ切り替え"
        title="ダーク/ライト切り替え"
      >
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 1.25rem;
    z-index: 50;
    margin-bottom: 2.5rem;
  }

  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1.25rem;
    background: var(--bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    box-shadow: var(--card-shadow);
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .nav-left {
    display: flex;
    align-items: center;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .nav-brand:hover {
    opacity: 0.85;
  }

  .brand-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: white;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.8rem;
    border-radius: 6px;
  }

  .brand-name {
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    color: var(--text-primary);
  }

  /* ナビゲーションリンク */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background-color: var(--tag-bg);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .icon-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
    background-color: var(--tag-bg);
    transform: scale(1.06);
  }

  :global(html.dark) .sun-icon { display: block; }
  :global(html.dark) .moon-icon { display: none; }
  :global(html.light) .sun-icon { display: none; }
  :global(html.light) .moon-icon { display: block; }

  /* レスポンシブ対応 */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .navbar-wrapper {
      top: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .navbar {
      border-radius: 16px;
      padding: 0.6rem 0.85rem;
    }
  }
</style>

